# APP CONFIGURATION (development, production, test)
NODE_ENV=development

# URL CONFIGURATION
NEXT_PUBLIC_APP_URL=http://localhost:3000


# API CONNECTIVITY (LARAVEL BACKEND)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-Side URL
NEXT_SERVER_API_URL=http://localhost:8000/api/v1


# AUTHENTICATION (e.g., NextAuth.js / Auth.js)
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters

# Base URL for NextAuth.js callbacks and redirects
NEXTAUTH_URL=http://localhost:3000

# OAuth):
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# PAYMENT GATEWAY (STRIKE / STRIPE / BRAINTREE)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_public_key

# Secret Key For Server-Side Operations (e.g., creating payment intents)
STRIPE_SECRET_KEY=sk_test_your_secret_key


# ANALYTICS & IMAGES (OPTIONAL)
# NEXT_PUBLIC_IMAGE_DOMAIN=localhost